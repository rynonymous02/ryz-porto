---
---
<section class="code-section" id="code">

  <!-- Decorative floating objects -->
  <div class="code-obj code-obj-bracket">{'{ }'}</div>
  <div class="code-obj code-obj-slash">//</div>
  <div class="code-obj code-obj-dot"></div>
  <div class="code-obj code-obj-dot2"></div>
  <div class="code-obj code-obj-semicolon">;</div>
  <div class="code-obj code-obj-arrow">&rarr;</div>

  <!-- Background SVG kiri bawah (back01) -->
  <img src="/images/back01.svg" class="code-big-left code-back01" alt="">

  <!-- Background SVG kanan bawah (back02) -->
  <img src="/images/back02.svg" class="code-big-right code-back02" alt="">

  <!-- Left: wireframe figure + floating tags -->
  <div class="code-left reveal reveal-left">
    <img src="/images/wireframe.webp" class="code-wireframe" alt="Wireframe figure">
    <div class="code-tag code-tag-top">
      <span class="code-tag-text" id="typed-portfolio">My Portfolio</span><span class="code-tag-cursor">_</span>
    </div>
    <div class="code-tag code-tag-mid">
      <span class="code-tag-text" id="typed-code">Code</span><span class="code-tag-cursor">_</span>
    </div>
    <div class="code-tag code-tag-bot">
      <span class="code-tag-text" id="typed-apps">Building Apps</span><span class="code-tag-cursor">_</span>
    </div>
  </div>

  <!-- Right: dua kolom marquee 1:1 dengan gambar -->
  <div class="code-right">

    <!-- Kolom kiri: scroll bawah ke atas (desktop) / kiri ke kanan (mobile) -->
    <div class="code-marquee-wrap">
      <div class="code-marquee-track">
        <!-- Set 1 -->
        <div class="code-marquee-group">
          <div class="code-card" onclick="window.location.href='/code/01-ryz-pos'"><img src="/images/code01.webp" alt="Ryz-POS"><span class="code-card-label">SaaS</span></div>
          <div class="code-card" onclick="window.location.href='/code/02-fiqoo'"><img src="/images/code02.webp" alt="Fiqoo"><span class="code-card-label">Mobile</span></div>
          <div class="code-card" onclick="window.location.href='/code/03-ryz-store'"><img src="/images/code03.webp" alt="Ryz.Store"><span class="code-card-label">E-Commerce</span></div>
          <div class="code-card" onclick="window.location.href='/code/04-sibm-guru'"><img src="/images/code04.webp" alt="SIBM Guru"><span class="code-card-label">System</span></div>
          <div class="code-card" onclick="window.location.href='/code/05-erp-ryz'"><img src="/images/code05.webp" alt="ERP Ryz"><span class="code-card-label">ERP</span></div>
        </div>
        <!-- Set 2 (exact duplicate for seamless loop) -->
        <div class="code-marquee-group" aria-hidden="true">
          <div class="code-card" onclick="window.location.href='/code/01-ryz-pos'"><img src="/images/code01.webp" alt="Ryz-POS"><span class="code-card-label">SaaS</span></div>
          <div class="code-card" onclick="window.location.href='/code/02-fiqoo'"><img src="/images/code02.webp" alt="Fiqoo"><span class="code-card-label">Mobile</span></div>
          <div class="code-card" onclick="window.location.href='/code/03-ryz-store'"><img src="/images/code03.webp" alt="Ryz.Store"><span class="code-card-label">E-Commerce</span></div>
          <div class="code-card" onclick="window.location.href='/code/04-sibm-guru'"><img src="/images/code04.webp" alt="SIBM Guru"><span class="code-card-label">System</span></div>
          <div class="code-card" onclick="window.location.href='/code/05-erp-ryz'"><img src="/images/code05.webp" alt="ERP Ryz"><span class="code-card-label">ERP</span></div>
        </div>
      </div>
    </div>

    <!-- Kolom kanan: scroll atas ke bawah (desktop) / kanan ke kiri (mobile) -->
    <div class="code-marquee-wrap">
      <div class="code-marquee-track">
        <!-- Set 1 -->
        <div class="code-marquee-group">
          <div class="code-card" onclick="window.location.href='/code/03-ryz-store'"><img src="/images/code03.webp" alt="Ryz.Store"><span class="code-card-label">E-Commerce</span></div>
          <div class="code-card" onclick="window.location.href='/code/04-sibm-guru'"><img src="/images/code04.webp" alt="SIBM Guru"><span class="code-card-label">System</span></div>
          <div class="code-card" onclick="window.location.href='/code/05-erp-ryz'"><img src="/images/code05.webp" alt="ERP Ryz"><span class="code-card-label">ERP</span></div>
          <div class="code-card" onclick="window.location.href='/code/01-ryz-pos'"><img src="/images/code01.webp" alt="Ryz-POS"><span class="code-card-label">SaaS</span></div>
          <div class="code-card" onclick="window.location.href='/code/02-fiqoo'"><img src="/images/code02.webp" alt="Fiqoo"><span class="code-card-label">Mobile</span></div>
        </div>
        <!-- Set 2 (exact duplicate for seamless loop) -->
        <div class="code-marquee-group" aria-hidden="true">
          <div class="code-card" onclick="window.location.href='/code/03-ryz-store'"><img src="/images/code03.webp" alt="Ryz.Store"><span class="code-card-label">E-Commerce</span></div>
          <div class="code-card" onclick="window.location.href='/code/04-sibm-guru'"><img src="/images/code04.webp" alt="SIBM Guru"><span class="code-card-label">System</span></div>
          <div class="code-card" onclick="window.location.href='/code/05-erp-ryz'"><img src="/images/code05.webp" alt="ERP Ryz"><span class="code-card-label">ERP</span></div>
          <div class="code-card" onclick="window.location.href='/code/01-ryz-pos'"><img src="/images/code01.webp" alt="Ryz-POS"><span class="code-card-label">SaaS</span></div>
          <div class="code-card" onclick="window.location.href='/code/02-fiqoo'"><img src="/images/code02.webp" alt="Fiqoo"><span class="code-card-label">Mobile</span></div>
        </div>
      </div>
    </div>

  </div>

</section>
