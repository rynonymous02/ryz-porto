---
---
<section class="hero" id="home">
  <div class="hero-left">

    <p class="hero-greeting">Hello, I'm</p>
    <h1 class="hero-name">Muhammad<br>Rizal</h1>
    <div class="hero-role"><span id="typed-role"></span><span class="typing-cursor">_</span></div>
    <p class="hero-desc">
      Crafting visual identities, brand experiences, and digital designs that leave a lasting impression. Turning
      ideas into bold, compelling visuals since 2018.
    </p>
    <div class="hero-glow-topright"></div>
    <!-- CTAs: visible on desktop inside hero-left -->
    <div class="hero-ctas hero-ctas-desktop">
      <a href="#portfolio" class="btn-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M5 3l14 9-14 9V3z" />
        </svg>
        View Portfolio
      </a>
      <a href="#contact" class="btn-secondary">Let's Talk →</a>
    </div>
  </div>

  <!-- Desktop photo (hidden on mobile) -->
  <div class="hero-right hero-right-desktop">
    <div class="hero-photo-wrap">
      <div class="hero-glow-topleft"></div>
      <div class="hero-photo-bg"></div>
      <img src="images/grid.webp" class="hero-grid-bg" alt="">
      <div class="hero-photo">
        <img src="images/profile.webp" alt="Muhammad Rizal — Graphic Designer">
      </div>
    </div>
  </div>

  <!-- Mobile photo inside hero section -->
  <div class="hero-photo-mobile-wrap">
    <div class="hero-photo-wrap" style="width:100%;max-width:100%;">
      <div class="hero-photo-bg"></div>
      <img src="images/grid.webp" class="hero-grid-bg" alt="">
      <div class="hero-photo">
        <img src="images/profile.webp" alt="Muhammad Rizal — Graphic Designer">
      </div>
    </div>
    <!-- CTAs overlaid on top of gradient, inside photo wrap -->
    <div class="hero-ctas hero-ctas-mobile">
      <a href="#portfolio" class="btn-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M5 3l14 9-14 9V3z" />
        </svg>
        View Portfolio
      </a>
      <a href="#contact" class="btn-secondary">Let's Talk →</a>
    </div>
  </div>

</section>
