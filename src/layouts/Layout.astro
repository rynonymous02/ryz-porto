---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Muhammad Rizal — Graphic Designer",
  description = "Crafting visual identities, brand experiences, and digital designs that leave a lasting impression. Turning ideas into bold, compelling visuals since 2018."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link
    href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap"
    rel="stylesheet">
</head>
<body>
  <slot />
</body>
</html>
